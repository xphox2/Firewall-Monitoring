# Binaries
bin/
*.exe
*.dll
*.so
*.dylib

# Vendor
vendor/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
config.env

# Runtime config volume (CONFIG_DIR, default ./config). Holds config.env — from
# which the AES-256 key for every {enc} secret is derived — and pg-credentials.
# The bare `config.env` pattern above matches that one file at any depth, but NOT
# its siblings, so a `git add -A` in a deployment checkout would stage the
# Postgres credentials. Ignore the whole directory; nothing in it is source.
config/

# Backup copies. Operators leave these beside the file they snapshot
# (config.env.broken.bak, docker-compose.yml.bak-<tag>, *.db.bak.<timestamp>),
# and they carry whatever secrets the original held.
*.bak
*.bak.*
*.bak-*

# Logs
*.log

# Data
data/
*.db

# TLS certificates
*.crt
*.key
*.pem

# Claude Code local settings (user-specific tool permissions)
.claude/

# Cookies / session files
cookies.txt

# Scratch / debug dump files
interfaces.json
IRC-FORMAT.txt

# Playwright MCP session dumps (dev-only)
.playwright-mcp/

# Admin password file (written at runtime)
.admin-password
node_modules/

# Go coverage artifacts (go test -cover -coverprofile)
coverage.out
coverage.html
/api
/poller
