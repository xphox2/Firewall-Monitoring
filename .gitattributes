# Normalize line endings to LF for all text files (AUDIT line-ending hygiene).
# The toolchain (gofmt, Go source, shell scripts run on Linux) is LF-native;
# without this, editing on Windows flip-flops CRLF<->LF and produces huge noisy
# diffs (and shell scripts with CRLF fail on Linux). `text=auto eol=lf` stores
# and checks out text files as LF regardless of platform.
* text=auto eol=lf

# Explicit LF for the formats we edit + execute.
*.go    text eol=lf
*.md    text eol=lf
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.conf  text eol=lf
Dockerfile text eol=lf
Makefile   text eol=lf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
