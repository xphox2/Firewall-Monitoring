# Firewall Monitor Configuration
# Copy this file to /etc/firewall-mon/config.env and edit the values

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_ENABLE_TLS=false
SERVER_TLS_CERT=/etc/firewall-mon/tls.crt
SERVER_TLS_KEY=/etc/firewall-mon/tls.key

# Security - IMPORTANT: Set these in production!
# Leave JWT_SECRET_KEY empty to auto-generate AND PERSIST a random secret to
# <SECRETS_DIR>/.jwt-secret (chmod 600) on first run; subsequent runs reload
# the same value. AUDIT-008: regenerating on every restart would invalidate
# every login JWT AND make every {enc}<base64> stored credential permanently
# unreadable (SNMP/IRC/SMTP) because the AES-256 key is derived from this
# secret. SECRETS_DIR defaults to /data (the Docker volume mount).
JWT_SECRET_KEY=
SECRETS_DIR=/data
# COOKIE_SECURE controls the Secure flag on session cookies. The browser
# silently drops a Secure-flagged cookie over plain HTTP, which means
# logins over `SERVER_ENABLE_TLS=false` will fail with no error to the
# operator — a classic "works on my machine" trap.
#
# AUDIT-024: the safe default is to inherit from SERVER_ENABLE_TLS, so
# leave COOKIE_SECURE UNSET unless you really mean to override. If you
# do set it explicitly to true, the server will WARN at startup that
# you're on a path where logins will be silently broken over HTTP.
# COOKIE_SECURE=
COOKIE_SAMESITE=Strict

# AUDIT-040: API singleton guard. The API keeps the IRC bots, login-lockout
# counters, rate-limit buckets, and uptime baseline in process memory, so only
# ONE fwmon-api may run against a database. By default a second instance refuses
# to start. Set true for follower mode (serves HTTP, but NO IRC bots; lockout/
# rate-limit/uptime are per-instance and diverge). See docs/OPERATIONS.md.
ALLOW_MULTI_API=false
# How long a starting API retries the singleton advisory lock before giving up,
# so a graceful predecessor mid-shutdown doesn't trigger a false refuse.
API_SINGLETON_LOCK_WAIT=10s

# Encryption key for {enc}<base64> stored credentials. Defaults to the
# JWT_SECRET_KEY value if unset (with a warning). Setting it explicitly
# is recommended so JWT and ENC concerns can be rotated independently.
#
# AUDIT-009 key rotation:
#   1. Save the CURRENT ENCRYPTION_KEY value.
#   2. Set ENCRYPTION_KEY to the NEW value.
#   3. Set ENCRYPTION_KEY_HISTORY to the OLD value (comma-separated if you
#      rotate again — newest historical first, e.g. "rot-2,rot-1,initial").
#   4. Restart. New writes use the new key; old reads fall through the chain.
#   5. Optional: run cmd/keyrotate (planned) or re-save each setting in the
#      admin UI to re-encrypt under the new key, then drop the old key from
#      ENCRYPTION_KEY_HISTORY.
ENCRYPTION_KEY=
ENCRYPTION_KEY_HISTORY=

# Admin Credentials
# Leave ADMIN_PASSWORD empty to auto-generate AND PERSIST a random password
# to <SECRETS_DIR>/.admin-password (chmod 600) on first run; subsequent runs
# reload the same value so login keeps working after every restart.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
BCRYPT_COST=12
TOKEN_EXPIRY=24h
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15m

# SNMP Configuration
SNMP_HOST=192.168.1.1
SNMP_PORT=161
SNMP_COMMUNITY=public
SNMP_VERSION=2c
SNMP_TIMEOUT=5s
SNMP_RETRIES=2
SNMP_POLL_INTERVAL=60s

# SNMP Trap Receiver
SNMP_TRAP_LISTEN=0.0.0.0:162
# REQUIRED: SNMP_TRAP_COMMUNITY must be a non-empty string. Empty / unset
# is rejected at startup (AUDIT-012) — an open community string lets
# anyone on the network inject arbitrary trap events into the alert
# pipeline. Set this to whatever community string your devices send.
# Per-source-IP rate limit (10 traps/sec, burst 50) is applied unconditionally.
SNMP_TRAP_COMMUNITY=public

# Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=firewall_mon
DB_PASSWORD=
DB_NAME=firewall_mon
# AUDIT-037: per-connection statement timeout (Postgres only).
# Enforced server-side via the connection string. 30s default
# is well above the slowest expected query (large chart time-
# series bucket, ~2-5s) and well below the 60s systemd restart
# cadence. Set to 0 to disable (not recommended for production).
DB_STATEMENT_TIMEOUT=30s

# AUDIT-149: GORM log level. Pre-fix this was hardcoded to
# `silent`, which swallowed slow-query warnings, errors, and
# migration warnings. New default is `warn` (slow queries,
# errors, migration warnings; doesn't log every successful
# statement, which would flood the log). Operators who want
# more visibility can set this to `info`. Valid values:
# silent | error | warn (default) | info.
DB_LOG_LEVEL=warn

# AUDIT-076: application structured logging (slog). The whole
# server log (including every legacy log.Printf, bridged through
# slog) is emitted by this logger. LOG_FORMAT picks the encoding:
#   text (default) → logfmt key=value, human-readable
#   json           → one JSON object per line, for Loki/ELK/Splunk
# LOG_LEVEL filters by severity: debug | info (default) | warn |
# error. Legacy log.Printf lines bridge in at info, so the default
# keeps the pre-AUDIT-076 verbosity; raising to warn drops them.
# Credential-named slog attributes (password/secret/token/key/
# community/...) are auto-redacted to REDACTED.
LOG_FORMAT=text
LOG_LEVEL=info

# Alert Thresholds
CPU_THRESHOLD=80.0
MEMORY_THRESHOLD=80.0
DISK_THRESHOLD=90.0
SESSION_THRESHOLD=100000
INTERFACE_DOWN_ALERT=true

# Email Notifications (optional)
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=firewall-mon@example.com
SMTP_TO=admin@example.com

# Webhook Notifications (optional)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
WEBHOOK_URL=

# Uptime Tracking
UPTIME_TRACKING_ENABLED=true
UPTIME_BASELINE_FILE=/var/lib/firewall-mon/uptime.json

# AUDIT-029: retention for the four tables that previously had no
# knob and grew unbounded. Defaults: 30 days for the stats tables,
# 7 days for IRC message logs. Set to 0 to inherit from
# RETENTION_DEFAULT_DAYS (90).
RETENTION_INTERFACE_ERRORS_DAYS=30
RETENTION_PROCESSOR_STATS_DAYS=30
RETENTION_PROCESS_STATS_DAYS=30
RETENTION_IRC_MESSAGE_LOG_DAYS=7

# AUDIT-031: retention for unacknowledged alerts. The pre-fix
# cleanup ignored unacked alerts entirely, so a critical device
# that paged off-hours and went unacked accumulated alert rows
# forever. Default 90 days: long enough to survive a vacation,
# short enough to bound the table. Each auto-archived alert
# fires a WARNING log so the operator can reconstruct the
# "stale unack" event from the logs.
RETENTION_UNACK_ALERT_DAYS=90
